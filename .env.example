# =============================================================================
# KnowRAG 环境变量样例
# -----------------------------------------------------------------------------
# 使用方式：复制为项目根目录下的 .env，再按需修改。
#   Windows : Copy-Item .env.example .env
#   Linux   : cp .env.example .env
#
# 安全约定（docs/CODING_CONVENTIONS.md 第 9 节）：
#   - .env 不得提交到版本库；
#   - JWT_SECRET 与 FERNET_KEY 故意留空，必须由使用者自行生成后填入，
#     避免「示例值即生产密钥」导致所有部署共用同一把公开密钥；
#   - 任何真实 API Key 都不写入本文件，用户 Key 由用户在设置页填写并入库存加密。
# =============================================================================

# --- 运行环境 ---
APP_ENV=development
APP_NAME=KnowRAG
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEBUG=true

# --- 安全 ---
# 两项都必须由你自己生成后填入，不要沿用任何公开示例值。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 留空或使用 change-me 时，登录鉴权一律不可用（Phase 1 起生效）。
JWT_SECRET=
JWT_EXPIRE_MINUTES=30
# refresh token 的类型有效期（天）。注意它还会被下面的月度上限进一步压缩：
# 月末签发的 refresh token 一律在「下个月 1 号 00:00:00」失效。
JWT_REFRESH_EXPIRE_DAYS=7

# --- Token 有效期上限策略（安全要求）---
# 所有 token（含 refresh / 刷新后重新签发的）都同时受三条约束，实际取最早的：
#   1. 类型自身有效期：JWT_EXPIRE_MINUTES / JWT_REFRESH_EXPIRE_DAYS
#   2. TOKEN_MAX_AGE_DAYS：签发后的绝对最长天数
#   3. 每月 TOKEN_MONTHLY_EXPIRE_DAY 号 00:00:00（TOKEN_TIMEZONE）强制过期
# 即 exp = min(签发时间 + 7 天, 签发时间之后的下一个每月 1 号 00:00:00)。
# 效果：每月 1 号 00:00:00（上海时间）所有用户都需要重新登录，属于业务明确要求。
# 时区名必须是有效的 IANA 名称；写错会在启动时直接报错（不会拖到登录时才炸）。
TOKEN_MAX_AGE_DAYS=7
TOKEN_MONTHLY_EXPIRE_DAY=1
TOKEN_TIMEZONE=Asia/Shanghai

# 用于加密用户 API Key，必须是合法 Fernet key（32 字节 urlsafe-base64）。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空时后端仍可启动（Phase 0 不依赖加密），但 Phase 2 保存 API Key 会失败。
# 注意：更换该值会导致库中已存的 API Key 无法解密，需让用户重新填写。
FERNET_KEY=

# --- 数据库 / 向量库（Phase 1、Phase 3 使用）---
# 数据库选型：MySQL 8.0（偏离 docs/DESIGN_IMPLEMENTATION.md 原定的 PostgreSQL）。
# 原因：本机提供的是 MySQL 8.0，且 7 张业务表未使用任何 PostgreSQL 专有能力。
# 库需已存在，字符集 utf8mb4 / 排序规则 utf8mb4_0900_ai_ci（大小写不敏感）。
# 建库语句：
#   CREATE DATABASE knowrag DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
# 注意：docker-compose 部署时会自动覆盖为容器内服务名，无需手改。
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/knowrag?charset=utf8mb4
CHROMA_HOST=localhost
CHROMA_PORT=8000
# 注意：本机 .env 里可能仍留着已废弃的 LOCAL_BGE_*/EMBED_DEVICE/RERANK_DEVICE，
# 它们不会被读取（Settings 配置为忽略未知变量），可以按需删除。
# 注意：本机 .env 里可能仍留着已废弃的 LOCAL_BGE_*/EMBED_DEVICE/RERANK_DEVICE，
# 它们不会被读取（Settings 配置为忽略未知变量），可以按需删除。
# 注意：本机 .env 里可能仍留着已废弃的 LOCAL_BGE_*/EMBED_DEVICE/RERANK_DEVICE，
# 它们不会被读取（Settings 配置为忽略未知变量），可以按需删除。

# --- 默认 provider（运维入口；仅影响"新建配置行"时的初值）---
# 本系统只支持远程 Provider。本地模型方案已于 2026-10-02 整体移除，
# 原先的 LOCAL_BGE_M3_PATH / LOCAL_BGE_RERANKER_PATH / EMBED_DEVICE / RERANK_DEVICE
# 环境变量一并删除（留着它们不会报错，但已经没有任何代码读取）。
# 取值必须在上表 provider 目录内（llm: deepseek/qwen，embed/rerank: qwen），
# 写错会回退到目录第一项并在启动日志里告警，不会导致启动失败。
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_EMBED_PROVIDER=qwen
DEFAULT_RERANK_PROVIDER=qwen

# --- CORS ---
# 多个来源用英文逗号分隔。生产环境必须收紧为真实域名，禁止使用 *。
CORS_ORIGINS=http://localhost:5173
